@{
    ViewData["Title"] = "Cari Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Cari Listesi</h3>
    <div class="d-flex align-items-center gap-3">
        <span id="kayitSayaci" class="badge bg-secondary">0 kayıt</span>
        <a asp-action="Ekle" class="btn btn-primary">+ Yeni Cari</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

<div id="antiforgeryAlani" class="d-none">
    @Html.AntiForgeryToken()
</div>

<div class="table-responsive">
    <table id="cariTablosu" class="table table-striped table-bordered align-middle w-100 grid-sticky-header">
        <thead>
            <tr>
                <th>Cari Kodu</th>
                <th>Unvan</th>
                <th>Cari Tipi</th>
                <th>Telefon</th>
                <th>E-Posta</th>
                <th>Bakiye</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th>
                    <select class="form-select form-select-sm sutun-filtre">
                        <option value="">Tümü</option>
                        <option value="Musteri">Müşteri</option>
                        <option value="Tedarikci">Tedarikçi</option>
                        <option value="HerIkisi">Her İkisi</option>
                    </select>
                </th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th></th>
                <th>
                    <select class="form-select form-select-sm sutun-filtre">
                        <option value="">Tümü</option>
                        <option value="false">Aktif</option>
                        <option value="true">Pasif</option>
                    </select>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            var antiforgeryTokenHtml = document.querySelector('#antiforgeryAlani input[name="__RequestVerificationToken"]').outerHTML;

            var tablo = new DataTable('#cariTablosu', {
                processing: true,
                serverSide: true,
                ajax: { url: '@Url.Action("ListeVerisi", "Cari")', type: 'POST' },
                order: [[0, 'asc']],
                language: { url: '@Url.Content("~/lib/datatables/i18n/tr.json")' },
                columns: [
                    { data: 'cariKodu' },
                    { data: 'unvan' },
                    { data: 'cariTipiText' },
                    { data: 'telefon' },
                    { data: 'eMail' },
                    {
                        data: 'bakiye',
                        render: function (data) {
                            return Number(data).toLocaleString('tr-TR', { minimumFractionDigits: 2 });
                        }
                    },
                    {
                        data: 'isDeleted',
                        render: function (data) {
                            return data
                                ? '<span class="badge bg-secondary">Pasif</span>'
                                : '<span class="badge bg-success">Aktif</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            var duzenle = '<a href="/Cari/Duzenle/' + row.id + '" class="btn btn-sm btn-outline-primary me-1">Düzenle</a>';
                            var url = row.isDeleted ? '/Cari/AktifEt/' + row.id : '/Cari/PasifYap/' + row.id;
                            var sinif = row.isDeleted ? 'btn-outline-success' : 'btn-outline-danger';
                            var metin = row.isDeleted ? 'Aktif Et' : 'Pasif Yap';
                            return duzenle +
                                '<form method="post" action="' + url + '" class="d-inline">' + antiforgeryTokenHtml +
                                '<button type="submit" class="btn btn-sm ' + sinif + '">' + metin + '</button></form>';
                        }
                    }
                ]
            });

            tablo.on('xhr.dt', function (e, settings, json) {
                document.getElementById('kayitSayaci').textContent = json.recordsFiltered + ' kayıt';
            });

            sutunFiltreleriBagla('cariTablosu', tablo);
        });
    </script>
}
