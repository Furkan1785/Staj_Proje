@model CariEkstreViewModel
@{
    ViewData["Title"] = "Cari Ekstresi";
}

<h3 class="mb-4">Cari Ekstresi</h3>

<form method="get" asp-action="Ekstre" class="row g-3 align-items-end p-3 border rounded bg-white mb-4">
    <div class="col-md-5">
        <label class="form-label">Cari</label>
        <select name="cariId" class="form-select" asp-items="Model.CariListesi">
            <option value="">Seçiniz</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Başlangıç Tarihi</label>
        <input type="date" name="baslangic" class="form-control" value="@Model.Baslangic.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Bitiş Tarihi</label>
        <input type="date" name="bitis" class="form-control" value="@Model.Bitis.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">Görüntüle</button>
    </div>
</form>

@if (Model.CariId is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">@Model.CariUnvan — @Model.Baslangic.ToString("dd.MM.yyyy") / @Model.Bitis.ToString("dd.MM.yyyy")</h5>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-success btn-sm"
               href="@Url.Action("EkstreExcel", new { cariId = Model.CariId, baslangic = Model.Baslangic.ToString("yyyy-MM-dd"), bitis = Model.Bitis.ToString("yyyy-MM-dd") })">
                Excel'e Aktar
            </a>
            <a class="btn btn-outline-danger btn-sm"
               href="@Url.Action("EkstrePdf", new { cariId = Model.CariId, baslangic = Model.Baslangic.ToString("yyyy-MM-dd"), bitis = Model.Bitis.ToString("yyyy-MM-dd") })">
                PDF'e Aktar
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Fiş No</th>
                    <th>Fiş Tipi</th>
                    <th>Açıklama</th>
                    <th class="text-end">Borç</th>
                    <th class="text-end">Alacak</th>
                    <th class="text-end">Bakiye</th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-light">
                    <td colspan="4"><strong>Devir Bakiyesi</strong></td>
                    <td></td>
                    <td></td>
                    <td class="text-end"><strong>@Model.DevirBakiye.ToString("N2")</strong></td>
                </tr>
                @if (Model.Satirlar.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Bu tarih aralığında hareket bulunamadı.</td>
                    </tr>
                }
                @foreach (var s in Model.Satirlar)
                {
                    <tr>
                        <td>@s.Tarih.ToString("dd.MM.yyyy")</td>
                        <td>@s.FisNo</td>
                        <td>@s.FisTipiText</td>
                        <td>@s.Aciklama</td>
                        <td class="text-end">@(s.Borc > 0 ? s.Borc.ToString("N2") : "")</td>
                        <td class="text-end">@(s.Alacak > 0 ? s.Alacak.ToString("N2") : "")</td>
                        <td class="text-end">@s.KumulatifBakiye.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="6" class="text-end"><strong>Son Bakiye</strong></td>
                    <td class="text-end"><strong>@Model.SonBakiye.ToString("N2")</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
