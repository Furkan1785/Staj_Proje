@{
    ViewData["Title"] = "Çek/Senet";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Çek/Senet</h3>
    <div class="d-flex align-items-center gap-3">
        <span id="kayitSayaci" class="badge bg-secondary">0 kayıt</span>
        <a asp-action="Ekle" class="btn btn-primary">+ Yeni Çek/Senet</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

<div class="table-responsive">
    <table id="cekSenetTablosu" class="table table-striped table-bordered align-middle w-100 grid-sticky-header">
        <thead>
            <tr>
                <th>Belge Tipi</th>
                <th>Belge No</th>
                <th>Cari</th>
                <th>Vade Tarihi</th>
                <th>Tutar</th>
                <th>Banka Adı</th>
                <th>Şube Adı</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
            <tr>
                <th>
                    <select class="form-select form-select-sm sutun-filtre">
                        <option value="">Tümü</option>
                        <option value="Cek">Çek</option>
                        <option value="Senet">Senet</option>
                    </select>
                </th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th></th>
                <th></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th>
                    <select class="form-select form-select-sm sutun-filtre">
                        <option value="">Tümü</option>
                        <option value="Portfoyde">Portföyde</option>
                        <option value="Tahsilde">Tahsilde</option>
                        <option value="Ciro">Ciro</option>
                        <option value="Karsiliksiz">Karşılıksız</option>
                        <option value="TahsilEdildi">Tahsil Edildi</option>
                    </select>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            var tablo = new DataTable('#cekSenetTablosu', {
                processing: true,
                serverSide: true,
                ajax: { url: '@Url.Action("ListeVerisi", "CekSenet")', type: 'POST' },
                order: [[3, 'asc']],
                language: { url: '@Url.Content("~/lib/datatables/i18n/tr.json")' },
                columns: [
                    { data: 'belgeTipiText' },
                    { data: 'belgeNo' },
                    { data: 'cariUnvan' },
                    {
                        data: 'vadeTarihi',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('tr-TR');
                        }
                    },
                    {
                        data: 'tutar',
                        render: function (data) {
                            return Number(data).toLocaleString('tr-TR', { minimumFractionDigits: 2 });
                        }
                    },
                    { data: 'bankaAdi', defaultContent: '' },
                    { data: 'subeAdi', defaultContent: '' },
                    { data: 'durumText' },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        render: function (id) {
                            return '<a href="/CekSenet/Duzenle/' + id + '" class="btn btn-sm btn-outline-primary">Düzenle</a>';
                        }
                    }
                ]
            });

            tablo.on('xhr.dt', function (e, settings, json) {
                document.getElementById('kayitSayaci').textContent = json.recordsFiltered + ' kayıt';
            });

            sutunFiltreleriBagla('cekSenetTablosu', tablo);
        });
    </script>
}
