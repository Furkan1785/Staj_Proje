@model List<AnlikStokViewModel>
@{
    ViewData["Title"] = "Kritik Stok Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Kritik Stok Listesi</h3>
    <span id="kayitSayaci" class="badge bg-secondary">0 kayıt</span>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-success">Şu anda minimum stok seviyesinin altında malzeme yok.</div>
}
else
{
    <div class="table-responsive">
        <table id="kritikStokTablosu" class="table table-striped table-bordered align-middle w-100 grid-sticky-header">
            <thead>
                <tr>
                    <th>Malzeme Kodu</th>
                    <th>Malzeme Adı</th>
                    <th>Kategori</th>
                    <th>Birim</th>
                    <th>Bakiye</th>
                    <th>Min Stok</th>
                    <th>Eksik Miktar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.MalzemeKodu</td>
                        <td>@m.MalzemeAdi</td>
                        <td>@(m.KategoriAdi ?? "-")</td>
                        <td>@m.Birim</td>
                        <td>@m.Bakiye.ToString("N2")</td>
                        <td>@m.MinStokMiktari.ToString("N2")</td>
                        <td class="text-danger fw-bold">@((m.MinStokMiktari - m.Bakiye).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            var tabloElemani = document.getElementById('kritikStokTablosu');
            if (!tabloElemani) {
                document.getElementById('kayitSayaci').textContent = '0 kayıt';
                return;
            }

            var tablo = new DataTable('#kritikStokTablosu', {
                order: [[5, 'desc']],
                language: { url: '@Url.Content("~/lib/datatables/i18n/tr.json")' }
            });

            document.getElementById('kayitSayaci').textContent = tablo.rows().count() + ' kayıt';
            tablo.on('draw', function () {
                document.getElementById('kayitSayaci').textContent = tablo.rows({ search: 'applied' }).count() + ' kayıt';
            });
        });
    </script>
}
