@model MalzemeGecmisiViewModel
@{
    ViewData["Title"] = "Malzeme Hareket Geçmişi";
}

<h3 class="mb-4">Malzeme Hareket Geçmişi</h3>

<form method="get" asp-action="MalzemeGecmisi" class="row g-3 align-items-end p-3 border rounded bg-white mb-4">
    <div class="col-md-4">
        <label class="form-label">Malzeme</label>
        <select name="malzemeId" class="form-select" asp-items="Model.MalzemeListesi">
            <option value="">Seçiniz</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Başlangıç Tarihi</label>
        <input type="date" name="baslangic" class="form-control" value="@Model.Baslangic?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Bitiş Tarihi</label>
        <input type="date" name="bitis" class="form-control" value="@Model.Bitis?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Şube</label>
        <select asp-for="SubeId" class="form-select" asp-items="Model.SubeListesi">
            <option value="">Tüm Şubeler</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">Göster</button>
    </div>
</form>

@if (Model.MalzemeId is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">@Model.MalzemeAdi</h5>
        <span class="badge bg-secondary">Güncel Bakiye: @Model.GuncelBakiye.ToString("N2") @Model.Birim</span>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Fiş No</th>
                    <th>Hareket Tipi</th>
                    <th>Şube</th>
                    <th class="text-end">Giriş</th>
                    <th class="text-end">Çıkış</th>
                    <th>Açıklama</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Satirlar.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Bu tarih aralığında onaylanmış hareket bulunamadı.</td>
                    </tr>
                }
                @foreach (var s in Model.Satirlar)
                {
                    <tr>
                        <td>@s.Tarih.ToString("dd.MM.yyyy")</td>
                        <td>@s.FisNo</td>
                        <td>@s.HareketTipiText</td>
                        <td>@s.SubeAdi</td>
                        <td class="text-end">@(s.Giris > 0 ? s.Giris.ToString("N2") : "")</td>
                        <td class="text-end">@(s.Cikis > 0 ? s.Cikis.ToString("N2") : "")</td>
                        <td>@s.Aciklama</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="4" class="text-end"><strong>Toplam</strong></td>
                    <td class="text-end"><strong>@Model.ToplamGiris.ToString("N2")</strong></td>
                    <td class="text-end"><strong>@Model.ToplamCikis.ToString("N2")</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
