@model DurumKoduViewModel
@{
    ViewData["Title"] = Model.Baslik;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="p-4 border rounded bg-white mt-4 text-center">
            <div class="display-4 text-muted mb-2">@Model.Kod</div>
            <h3 class="mb-3">@Model.Baslik</h3>
            <p class="text-muted">@Model.Mesaj</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Anasayfaya dön</a>
        </div>
    </div>
</div>
