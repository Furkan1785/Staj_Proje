@model MalzemeHareketFisiFormViewModel
@{
    ViewData["Title"] = "Yeni Malzeme Hareket Fişi";
}

<h3 class="mb-4">Yeni Malzeme Hareket Fişi</h3>

<form asp-action="Ekle" method="post" class="p-4 border rounded bg-white">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <label asp-for="Tarih" class="form-label"></label>
            <input asp-for="Tarih" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="HareketTipi" class="form-label"></label>
            <select asp-for="HareketTipi" class="form-select" asp-items="Html.GetEnumSelectList<HareketTipi>()"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="SubeId" class="form-label"></label>
            <select asp-for="SubeId" class="form-select" asp-items="Model.SubeListesi">
                <option value="">Seçiniz</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Barkod ile Ekle</label>
        <div class="input-group" style="max-width: 420px;">
            <input type="text" id="barkodInput" class="form-control" placeholder="Barkodu okutun veya girin, Enter'a basın" autocomplete="off" />
            <button type="button" id="barkodEkleBtn" class="btn btn-outline-primary">Ekle</button>
        </div>
        <div id="barkodUyari" class="text-danger small mt-1 d-none">Bu barkoda sahip malzeme bulunamadı.</div>
    </div>

    <h5>Kalemler</h5>
    <table id="kalemlerTablosu" class="table table-bordered align-middle">
        <thead>
            <tr>
                <th style="width: 40%">Malzeme</th>
                <th style="width: 12%">Birim</th>
                <th style="width: 15%">Miktar</th>
                <th>Açıklama</th>
                <th style="width: 5%"></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
    <button type="button" id="satirEkleBtn" class="btn btn-outline-secondary btn-sm mb-4">+ Satır Ekle</button>

    <div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var malzemeListesi = @Json.Serialize(ViewData["MalzemeListesiJson"]);
            var mevcutKalemler = @Json.Serialize(Model.Kalemler.Select(k => new { malzemeId = k.MalzemeId, miktar = k.Miktar, aciklama = k.Aciklama }));
            var tbody = document.querySelector('#kalemlerTablosu tbody');

            function birimBul(malzemeId) {
                var m = malzemeListesi.find(function (x) { return x.id === malzemeId; });
                return m ? m.birim : '';
            }

            function satirEkle(veri) {
                veri = veri || { malzemeId: null, miktar: '', aciklama: '' };

                var malzemeOptions = '<option value="">Seçiniz</option>' + malzemeListesi.map(function (m) {
                    var secili = veri.malzemeId === m.id ? ' selected' : '';
                    return '<option value="' + m.id + '" data-birim="' + m.birim + '"' + secili + '>' + m.kod + ' - ' + m.ad + '</option>';
                }).join('');

                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td><select class="form-select form-select-sm malzeme-secimi" required>' + malzemeOptions + '</select></td>' +
                    '<td><input type="text" class="form-control form-control-sm birim-goster" readonly value="' + birimBul(veri.malzemeId) + '" /></td>' +
                    '<td><input type="number" step="0.01" min="0.01" class="form-control form-control-sm miktar-input" value="' + (veri.miktar || '') + '" required /></td>' +
                    '<td><input type="text" class="form-control form-control-sm aciklama-input" value="' + (veri.aciklama || '') + '" /></td>' +
                    '<td><button type="button" class="btn btn-sm btn-outline-danger satir-sil">Sil</button></td>';
                tbody.appendChild(tr);
            }

            function satirlariYenidenIndeksle() {
                Array.from(tbody.querySelectorAll('tr')).forEach(function (tr, i) {
                    tr.querySelector('.malzeme-secimi').name = 'Kalemler[' + i + '].MalzemeId';
                    tr.querySelector('.miktar-input').name = 'Kalemler[' + i + '].Miktar';
                    tr.querySelector('.aciklama-input').name = 'Kalemler[' + i + '].Aciklama';
                });
            }

            tbody.addEventListener('change', function (e) {
                if (e.target.classList.contains('malzeme-secimi')) {
                    var secilen = e.target.options[e.target.selectedIndex];
                    e.target.closest('tr').querySelector('.birim-goster').value = secilen.getAttribute('data-birim') || '';
                }
            });

            tbody.addEventListener('click', function (e) {
                if (e.target.classList.contains('satir-sil')) {
                    if (tbody.querySelectorAll('tr').length > 1) {
                        e.target.closest('tr').remove();
                        satirlariYenidenIndeksle();
                    }
                }
            });

            document.getElementById('satirEkleBtn').addEventListener('click', function () {
                satirEkle();
                satirlariYenidenIndeksle();
            });

            var barkodInput = document.getElementById('barkodInput');
            var barkodUyari = document.getElementById('barkodUyari');

            function barkodIleEkle() {
                var deger = barkodInput.value.trim();
                if (!deger) return;

                var bulunan = malzemeListesi.find(function (m) { return m.barkod === deger; });
                if (!bulunan) {
                    barkodUyari.classList.remove('d-none');
                    return;
                }

                barkodUyari.classList.add('d-none');
                satirEkle({ malzemeId: bulunan.id, miktar: '', aciklama: '' });
                satirlariYenidenIndeksle();
                barkodInput.value = '';
                var sonSatir = tbody.querySelector('tr:last-child');
                sonSatir.querySelector('.miktar-input').focus();
            }

            barkodInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    barkodIleEkle();
                }
            });
            document.getElementById('barkodEkleBtn').addEventListener('click', barkodIleEkle);

            if (mevcutKalemler.length > 0) {
                mevcutKalemler.forEach(function (k) { satirEkle(k); });
            } else {
                satirEkle();
            }
            satirlariYenidenIndeksle();
        })();
    </script>
}
