@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="p-4 border rounded bg-white mt-4">
            <h3 class="mb-3 text-center">Şifremi Unuttum</h3>
            <p class="text-muted">Kayıtlı e-posta adresinizi girin, şifre sıfırlama bağlantısı gönderelim.</p>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Sıfırlama Bağlantısı Gönder</button>

                <div class="text-center mt-3">
                    <a asp-action="Login">Girişe dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
