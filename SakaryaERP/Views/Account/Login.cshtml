@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="p-4 border rounded bg-white mt-4">
            <h3 class="mb-4 text-center">TicariSistem'e Giriş</h3>

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Sifre" class="form-label"></label>
                    <input asp-for="Sifre" class="form-control" />
                    <span asp-validation-for="Sifre" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="BeniHatirla" class="form-check-input" />
                    <label asp-for="BeniHatirla" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>

                <div class="text-center mt-3">
                    <a asp-action="ForgotPassword">Şifremi unuttum</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
