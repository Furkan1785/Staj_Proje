<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicariSistem</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232a78d6'/%3E%3Ctext x='32' y='45' font-family='Arial, sans-serif' font-size='36' font-weight='700' fill='white' text-anchor='middle'%3ET%3C/text%3E%3C/svg%3E" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SakaryaERP.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var girisliMi = User.Identity?.IsAuthenticated == true;
    var finansGorunur = User.IsInRole("Admin") || User.IsInRole("Muhasebe");
    var satisGorunur = User.IsInRole("Admin") || User.IsInRole("Satis");
    var aktifController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool Aktif(params string[] controllerAdlari) => controllerAdlari.Contains(aktifController, StringComparer.OrdinalIgnoreCase);
}
@if (!girisliMi)
{
    <div class="container">
        <main class="pb-3">
            @RenderBody()
        </main>
    </div>
}
else
{
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <nav class="app-sidebar" id="appSidebar">
            <div class="app-sidebar-brand">
                <a asp-area="" asp-controller="Dashboard" asp-action="Index">TicariSistem</a>
            </div>
            <div class="app-sidebar-nav">
                <a class="nav-link @(Aktif("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Anasayfa</a>
                <a class="nav-link @(Aktif("BelgeTakip") ? "active" : "")" asp-controller="BelgeTakip" asp-action="Index">Belge Takip</a>

                @if (finansGorunur)
                {
                    <div class="nav-section-title">Finans</div>
                    <a class="nav-link @(Aktif("Cari") ? "active" : "")" asp-controller="Cari" asp-action="Index">Cariler</a>
                    <a class="nav-link @(Aktif("CariFisi") ? "active" : "")" asp-controller="CariFisi" asp-action="Index">Cari Fişleri</a>
                    <a class="nav-link" asp-controller="Cari" asp-action="Ekstre">Cari Ekstresi</a>
                    <a class="nav-link @(Aktif("BankaHesabi") ? "active" : "")" asp-controller="BankaHesabi" asp-action="Index">Banka Hesapları</a>
                    <a class="nav-link @(Aktif("KasaHesabi") ? "active" : "")" asp-controller="KasaHesabi" asp-action="Index">Kasa Hesapları</a>
                    <a class="nav-link @(Aktif("CekSenet") ? "active" : "")" asp-controller="CekSenet" asp-action="Index">Çek/Senet</a>
                }

                <div class="nav-section-title">Malzeme</div>
                <a class="nav-link @(Aktif("Malzeme") ? "active" : "")" asp-controller="Malzeme" asp-action="Index">Malzeme Kartları</a>
                <a class="nav-link @(Aktif("MalzemeHareketFisi") ? "active" : "")" asp-controller="MalzemeHareketFisi" asp-action="Index">Hareket Fişleri</a>
                <a class="nav-link" asp-controller="StokRaporu" asp-action="AnlikDurum">Anlık Stok Durumu</a>
                <a class="nav-link" asp-controller="StokRaporu" asp-action="KritikStok">Kritik Stok Listesi</a>
                <a class="nav-link" asp-controller="StokRaporu" asp-action="MalzemeGecmisi">Malzeme Hareket Geçmişi</a>

                @if (finansGorunur)
                {
                    <div class="nav-section-title">Satınalma</div>
                    <a class="nav-link @(Aktif("AlisSiparisi") ? "active" : "")" asp-controller="AlisSiparisi" asp-action="Index">Alış Siparişleri</a>
                    <a class="nav-link @(Aktif("AlisIrsaliyesi") ? "active" : "")" asp-controller="AlisIrsaliyesi" asp-action="Index">Alış İrsaliyeleri</a>
                    <a class="nav-link @(Aktif("AlisFaturasi") ? "active" : "")" asp-controller="AlisFaturasi" asp-action="Index">Alış Faturaları</a>
                    <a class="nav-link" asp-controller="SatinalmaRaporu" asp-action="Ozet">Satınalma Özet Raporu</a>
                }

                @if (satisGorunur)
                {
                    <div class="nav-section-title">Satış</div>
                    <a class="nav-link @(Aktif("MusteriTalebi") ? "active" : "")" asp-controller="MusteriTalebi" asp-action="Index">Müşteri Talepleri</a>
                    <a class="nav-link @(Aktif("SatisTeklifi") ? "active" : "")" asp-controller="SatisTeklifi" asp-action="Index">Satış Teklifleri</a>
                    <a class="nav-link @(Aktif("SatisSiparisi") ? "active" : "")" asp-controller="SatisSiparisi" asp-action="Index">Satış Siparişleri</a>
                    <a class="nav-link @(Aktif("SevkIrsaliyesi") ? "active" : "")" asp-controller="SevkIrsaliyesi" asp-action="Index">Sevk İrsaliyeleri</a>
                    <a class="nav-link @(Aktif("SatisFaturasi") ? "active" : "")" asp-controller="SatisFaturasi" asp-action="Index">Satış Faturaları</a>
                    <a class="nav-link" asp-controller="SatisRaporu" asp-action="Ozet">Satış Özet Raporu</a>
                }

                @if (finansGorunur)
                {
                    <div class="nav-section-title">Muhasebe</div>
                    <a class="nav-link @(Aktif("HesapPlani") ? "active" : "")" asp-controller="HesapPlani" asp-action="Index">Hesap Planı</a>
                    <a class="nav-link @(Aktif("KdvRaporu") ? "active" : "")" asp-controller="KdvRaporu" asp-action="Ozet">KDV Özet Raporu</a>
                    <a class="nav-link @(Aktif("Mizan") ? "active" : "")" asp-controller="Mizan" asp-action="Ozet">Mizan</a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-section-title">Yönetim</div>
                    <a class="nav-link @(Aktif("Kullanici") ? "active" : "")" asp-controller="Kullanici" asp-action="Index">Kullanıcılar</a>
                }

                <div class="nav-section-title">Diğer</div>
                <a class="nav-link @(Aktif("Sube") ? "active" : "")" asp-controller="Sube" asp-action="Index">Şubeler</a>
                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
            </div>
            <div class="app-sidebar-user">
                <div class="text-truncate mb-2">@User.Identity!.Name</div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-light w-100">Çıkış Yap</button>
                </form>
            </div>
        </nav>

        <div class="app-content">
            <header class="app-topbar">
                <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Menüyü aç/kapat">&#9776;</button>
                <div class="app-topbar-title">@ViewData["Title"]</div>
            </header>
            <main class="app-main">
                @RenderBody()
            </main>
            <footer class="border-top text-muted small py-3 px-4">
                &copy; 2026 - TicariSistem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
            </footer>
        </div>
    </div>
}
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
