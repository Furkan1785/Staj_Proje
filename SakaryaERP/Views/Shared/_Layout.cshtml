<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SakaryaERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SakaryaERP.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SakaryaERP</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Finans</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Cari" asp-action="Index">Cariler</a></li>
                                <li><a class="dropdown-item" asp-controller="CariFisi" asp-action="Index">Cari Fişleri</a></li>
                                <li><a class="dropdown-item" asp-controller="Cari" asp-action="Ekstre">Cari Ekstresi</a></li>
                                <li><a class="dropdown-item" asp-controller="BankaHesabi" asp-action="Index">Banka Hesapları</a></li>
                                <li><a class="dropdown-item" asp-controller="KasaHesabi" asp-action="Index">Kasa Hesapları</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="CekSenet" asp-action="Index">Çek/Senet</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Malzeme</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Malzeme" asp-action="Index">Malzeme Kartları</a></li>
                                <li><a class="dropdown-item" asp-controller="MalzemeHareketFisi" asp-action="Index">Hareket Fişleri</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="StokRaporu" asp-action="AnlikDurum">Anlık Stok Durumu</a></li>
                                <li><a class="dropdown-item" asp-controller="StokRaporu" asp-action="KritikStok">Kritik Stok Listesi</a></li>
                                <li><a class="dropdown-item" asp-controller="StokRaporu" asp-action="MalzemeGecmisi">Malzeme Hareket Geçmişi</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Satınalma</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="AlisSiparisi" asp-action="Index">Alış Siparişleri</a></li>
                                <li><a class="dropdown-item" asp-controller="AlisIrsaliyesi" asp-action="Index">Alış İrsaliyeleri</a></li>
                                <li><a class="dropdown-item" asp-controller="AlisFaturasi" asp-action="Index">Alış Faturaları</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Sube" asp-action="Index">Şubeler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SakaryaERP - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
