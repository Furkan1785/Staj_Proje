@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="p-4 border rounded bg-white mt-4 text-center">
            <div class="display-4 text-danger mb-2">!</div>
            <h3 class="mb-3">Bir Hata Oluştu</h3>
            <p class="text-muted">İsteğiniz işlenirken beklenmeyen bir hata meydana geldi. Lütfen tekrar deneyin;
                sorun devam ederse sistem yöneticinizle iletişime geçin.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-muted small">İstek No: <code>@Model.RequestId</code></p>
            }
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Anasayfaya dön</a>
        </div>
    </div>
</div>
