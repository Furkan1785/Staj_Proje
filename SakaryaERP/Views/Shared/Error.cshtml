@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Bir hata oluştu.</h1>
<h2 class="text-danger">İsteğiniz işlenirken beklenmeyen bir hata meydana geldi.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek No:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Lütfen tekrar deneyin. Sorun devam ederse sistem yöneticinizle iletişime geçin.</p>
