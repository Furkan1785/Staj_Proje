@model SatisSiparisiFormViewModel
@{
    ViewData["Title"] = "Yeni Satış Siparişi";
}

<h3 class="mb-4">Yeni Satış Siparişi</h3>

@if (Model.TeklifNoGosterim != null)
{
    <div class="alert alert-info">Bu sipariş <strong>@Model.TeklifNoGosterim</strong> numaralı satış teklifinden oluşturuluyor.</div>
}

<form asp-action="Ekle" method="post" class="p-4 border rounded bg-white">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="SatisTeklifiId" />

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <label asp-for="Tarih" class="form-label"></label>
            <input asp-for="Tarih" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="CariId" class="form-label"></label>
            <select asp-for="CariId" class="form-select" asp-items="Model.MusteriListesi">
                <option value="">Seçiniz</option>
            </select>
        </div>
        <div class="col-md-8">
            <label asp-for="Aciklama" class="form-label"></label>
            <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <h5>Kalemler</h5>
    <table id="kalemlerTablosu" class="table table-bordered align-middle">
        <thead>
            <tr>
                <th style="width: 28%">Malzeme</th>
                <th style="width: 8%">Birim</th>
                <th style="width: 11%">Miktar</th>
                <th style="width: 12%">Birim Fiyat</th>
                <th style="width: 10%">İskonto (%)</th>
                <th style="width: 10%">KDV (%)</th>
                <th style="width: 15%">Satır Toplamı</th>
                <th style="width: 5%"></th>
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
            <tr class="table-light">
                <td colspan="6" class="text-end"><strong>Genel Toplam</strong></td>
                <td id="genelToplam" class="fw-bold">0,00</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
    <button type="button" id="satirEkleBtn" class="btn btn-outline-secondary btn-sm mb-4">+ Satır Ekle</button>

    <div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var malzemeListesi = @Json.Serialize(ViewData["MalzemeListesiJson"]);
            var mevcutKalemler = @Json.Serialize(Model.Kalemler.Select(k => new { malzemeId = k.MalzemeId, miktar = k.Miktar, birimFiyat = k.BirimFiyat, iskonto = k.Iskonto, kdvOrani = k.KdvOrani }));
            var tbody = document.querySelector('#kalemlerTablosu tbody');
            var genelToplamElemani = document.getElementById('genelToplam');

            function sayiFormatla(deger) {
                return deger.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function birimBul(malzemeId) {
                var m = malzemeListesi.find(function (x) { return x.id === malzemeId; });
                return m ? m.birim : '';
            }

            function satirToplamiHesapla(tr) {
                var miktar = parseFloat(tr.querySelector('.miktar-input').value) || 0;
                var birimFiyat = parseFloat(tr.querySelector('.birimfiyat-input').value) || 0;
                var iskonto = parseFloat(tr.querySelector('.iskonto-input').value) || 0;
                var kdv = parseFloat(tr.querySelector('.kdv-input').value) || 0;

                var araToplam = miktar * birimFiyat;
                var iskontolu = araToplam * (1 - iskonto / 100);
                var toplam = iskontolu * (1 + kdv / 100);

                tr.querySelector('.satir-toplami').textContent = sayiFormatla(toplam);
                return toplam;
            }

            function genelToplamiGuncelle() {
                var toplam = 0;
                Array.from(tbody.querySelectorAll('tr')).forEach(function (tr) {
                    toplam += satirToplamiHesapla(tr);
                });
                genelToplamElemani.textContent = sayiFormatla(toplam);
            }

            function satirEkle(veri) {
                veri = veri || { malzemeId: null, miktar: '', birimFiyat: '', iskonto: 0, kdvOrani: 20 };

                var malzemeOptions = '<option value="">Seçiniz</option>' + malzemeListesi.map(function (m) {
                    var secili = veri.malzemeId === m.id ? ' selected' : '';
                    return '<option value="' + m.id + '" data-birim="' + m.birim + '"' + secili + '>' + m.kod + ' - ' + m.ad + '</option>';
                }).join('');

                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td><select class="form-select form-select-sm malzeme-secimi" required>' + malzemeOptions + '</select></td>' +
                    '<td><input type="text" class="form-control form-control-sm birim-goster" readonly value="' + birimBul(veri.malzemeId) + '" /></td>' +
                    '<td><input type="number" step="0.01" min="0.01" class="form-control form-control-sm miktar-input" value="' + (veri.miktar || '') + '" required /></td>' +
                    '<td><input type="number" step="0.01" min="0" class="form-control form-control-sm birimfiyat-input" value="' + (veri.birimFiyat || '') + '" required /></td>' +
                    '<td><input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm iskonto-input" value="' + veri.iskonto + '" /></td>' +
                    '<td><input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm kdv-input" value="' + veri.kdvOrani + '" /></td>' +
                    '<td class="text-end satir-toplami">0,00</td>' +
                    '<td><button type="button" class="btn btn-sm btn-outline-danger satir-sil">Sil</button></td>';
                tbody.appendChild(tr);
                satirToplamiHesapla(tr);
            }

            function satirlariYenidenIndeksle() {
                Array.from(tbody.querySelectorAll('tr')).forEach(function (tr, i) {
                    tr.querySelector('.malzeme-secimi').name = 'Kalemler[' + i + '].MalzemeId';
                    tr.querySelector('.miktar-input').name = 'Kalemler[' + i + '].Miktar';
                    tr.querySelector('.birimfiyat-input').name = 'Kalemler[' + i + '].BirimFiyat';
                    tr.querySelector('.iskonto-input').name = 'Kalemler[' + i + '].Iskonto';
                    tr.querySelector('.kdv-input').name = 'Kalemler[' + i + '].KdvOrani';
                });
            }

            tbody.addEventListener('change', function (e) {
                if (e.target.classList.contains('malzeme-secimi')) {
                    var secilen = e.target.options[e.target.selectedIndex];
                    e.target.closest('tr').querySelector('.birim-goster').value = secilen.getAttribute('data-birim') || '';
                }
            });

            tbody.addEventListener('input', function (e) {
                if (e.target.classList.contains('miktar-input') || e.target.classList.contains('birimfiyat-input') ||
                    e.target.classList.contains('iskonto-input') || e.target.classList.contains('kdv-input')) {
                    genelToplamiGuncelle();
                }
            });

            tbody.addEventListener('click', function (e) {
                if (e.target.classList.contains('satir-sil')) {
                    if (tbody.querySelectorAll('tr').length > 1) {
                        e.target.closest('tr').remove();
                        satirlariYenidenIndeksle();
                        genelToplamiGuncelle();
                    }
                }
            });

            document.getElementById('satirEkleBtn').addEventListener('click', function () {
                satirEkle();
                satirlariYenidenIndeksle();
                genelToplamiGuncelle();
            });

            if (mevcutKalemler.length > 0) {
                mevcutKalemler.forEach(function (k) { satirEkle(k); });
            } else {
                satirEkle();
            }
            satirlariYenidenIndeksle();
            genelToplamiGuncelle();
        })();
    </script>
}
