@using SakaryaERP.Models
@model AlisSiparisiDetayViewModel
@{
    ViewData["Title"] = "Alış Siparişi Detayı";

    var durumSinifi = Model.Durum switch
    {
        BelgeDurum.Beklemede => "bg-warning text-dark",
        BelgeDurum.Onaylandi => "bg-success",
        BelgeDurum.Iptal => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Alış Siparişi <small class="text-muted">(@Model.SiparisNo)</small></h3>
    <div class="d-flex gap-2">
        @if (Model.Durum == BelgeDurum.Beklemede)
        {
            <form method="post" asp-action="Onayla" asp-route-id="@Model.Id" onsubmit="return confirm('Bu sipariş onaylansın mı?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success">Onayla</button>
            </form>
            <form method="post" asp-action="IptalEt" asp-route-id="@Model.Id" onsubmit="return confirm('Bu sipariş iptal edilsin mi?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">İptal Et</button>
            </form>
        }
        @if (Model.Durum == BelgeDurum.Onaylandi && Model.Kalemler.Any(k => k.KalanMiktar > 0))
        {
            <a asp-controller="AlisIrsaliyesi" asp-action="Ekle" asp-route-siparisId="@Model.Id" class="btn btn-outline-primary">İrsaliye Oluştur</a>
        }
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">PDF</a>
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        Sipariş Bilgileri
        <span class="badge @durumSinifi">@Model.DurumText</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Tarih</dt>
            <dd class="col-sm-4">@Model.Tarih.ToString("dd.MM.yyyy")</dd>
            <dt class="col-sm-2">Tedarikçi</dt>
            <dd class="col-sm-4"><partial name="_CariLinki" model="(Model.CariId, Model.CariUnvan)" /></dd>
            <dt class="col-sm-2">Şube</dt>
            <dd class="col-sm-4">@Model.SubeAdi</dd>
            <dt class="col-sm-2">Açıklama</dt>
            <dd class="col-sm-10">@(Model.Aciklama ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">Kalemler ve Teslim Durumu</div>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Malzeme Kodu</th>
                    <th>Malzeme Adı</th>
                    <th>Birim</th>
                    <th class="text-end">Sipariş Miktarı</th>
                    <th class="text-end">Birim Fiyat</th>
                    <th class="text-end">İskonto %</th>
                    <th class="text-end">KDV %</th>
                    <th class="text-end">Satır Toplamı</th>
                    <th class="text-end">Teslim Alınan</th>
                    <th class="text-end">Kalan</th>
                    <th style="min-width: 160px;">Teslim Yüzdesi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.Kalemler)
                {
                    var barSinifi = k.TeslimYuzdesi >= 100 ? "bg-success" : k.TeslimYuzdesi > 0 ? "bg-warning" : "bg-secondary";
                    <tr>
                        <td>@k.MalzemeKodu</td>
                        <td>@k.MalzemeAdi</td>
                        <td>@k.Birim</td>
                        <td class="text-end">@k.Miktar.ToString("N2")</td>
                        <td class="text-end">@k.BirimFiyat.ToString("N2")</td>
                        <td class="text-end">@k.Iskonto.ToString("N2")</td>
                        <td class="text-end">@k.KdvOrani.ToString("N2")</td>
                        <td class="text-end">@k.SatirToplami.ToString("N2")</td>
                        <td class="text-end">@k.TeslimAlinanMiktar.ToString("N2")</td>
                        <td class="text-end">@k.KalanMiktar.ToString("N2")</td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar @barSinifi" style="width: @k.TeslimYuzdesi.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;">
                                    %@k.TeslimYuzdesi.ToString("N0")
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="7" class="text-end">Genel Toplam</th>
                    <th class="text-end">@Model.ToplamTutar.ToString("N2")</th>
                    <th colspan="3"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
