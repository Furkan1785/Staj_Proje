@{
    ViewData["Title"] = "Satış Teklifleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Satış Teklifleri</h3>
    <div class="d-flex align-items-center gap-3">
        <span id="kayitSayaci" class="badge bg-secondary">0 kayıt</span>
        <a asp-action="Excel" class="btn btn-outline-success">Excel'e Aktar</a>
        <a asp-action="Ekle" class="btn btn-primary">+ Yeni Teklif</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<p class="text-muted small mb-2">
    Durum rengi:
    <span class="badge bg-warning text-dark">Beklemede</span>
    <span class="badge bg-success">Onaylandı</span>
    <span class="badge bg-secondary">İptal</span>
</p>

<div class="table-responsive">
    <table id="satisTeklifiTablosu" class="table table-striped table-bordered align-middle w-100 grid-sticky-header">
        <thead>
            <tr>
                <th>Teklif No</th>
                <th>Tarih</th>
                <th>Geçerlilik</th>
                <th>Müşteri</th>
                <th>Talep No</th>
                <th>Durum</th>
                <th>Toplam Tutar</th>
                <th>İşlemler</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th></th>
                <th></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th></th>
                <th>
                    <select class="form-select form-select-sm sutun-filtre">
                        <option value="">Tümü</option>
                        <option value="Beklemede">Beklemede</option>
                        <option value="Onaylandi">Onaylandı</option>
                        <option value="Iptal">İptal</option>
                    </select>
                </th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<form id="csrfTokenHolder" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            var csrfToken = document.querySelector('#csrfTokenHolder input[name="__RequestVerificationToken"]').value;

            function aksiyonFormuOlustur(action, id, dugmeSinifi, dugmeMetni, onay) {
                return '<form method="post" action="/SatisTeklifi/' + action + '" class="d-inline" onsubmit="return confirm(\'' + onay + '\')">' +
                    '<input type="hidden" name="__RequestVerificationToken" value="' + csrfToken + '" />' +
                    '<input type="hidden" name="id" value="' + id + '" />' +
                    '<button type="submit" class="btn btn-sm ' + dugmeSinifi + '">' + dugmeMetni + '</button></form>';
            }

            var tablo = new DataTable('#satisTeklifiTablosu', {
                processing: true,
                serverSide: true,
                ajax: { url: '@Url.Action("ListeVerisi", "SatisTeklifi")', type: 'POST' },
                order: [[1, 'desc']],
                language: { url: '@Url.Content("~/lib/datatables/i18n/tr.json")' },
                columns: [
                    { data: 'teklifNo', render: DataTable.render.text() },
                    {
                        data: 'tarih',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('tr-TR');
                        }
                    },
                    {
                        data: 'gecerlilikTarihi',
                        orderable: false,
                        searchable: false,
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('tr-TR') : '-';
                        }
                    },
                    { data: 'cariUnvan', render: DataTable.render.text() },
                    { data: 'talepNo', orderable: false, searchable: false , render: DataTable.render.text()},
                    { data: 'durumText', render: DataTable.render.text() },
                    {
                        data: 'toplamTutar',
                        orderable: false,
                        searchable: false,
                        render: function (data) {
                            return Number(data).toLocaleString('tr-TR', { minimumFractionDigits: 2 });
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        render: function (id, type, row) {
                            var html = '<div class="d-flex flex-wrap gap-1">';
                            html += '<a href="/SatisTeklifi/Detay/' + id + '" class="btn btn-sm btn-outline-primary">Detay</a>';
                            html += '<a href="/SatisTeklifi/Pdf/' + id + '" class="btn btn-sm btn-outline-secondary" target="_blank">PDF</a>';
                            if (row.durum === 'Beklemede') {
                                html += aksiyonFormuOlustur('Onayla', id, 'btn-outline-success', 'Onayla', 'Bu teklif onaylansın mı?');
                                html += aksiyonFormuOlustur('IptalEt', id, 'btn-outline-danger', 'İptal Et', 'Bu teklif iptal edilsin mi?');
                            }
                            html += '</div>';
                            return html;
                        }
                    }
                ],
                createdRow: function (row, data) {
                    if (data.durum === 'Beklemede') {
                        row.classList.add('table-warning');
                    } else if (data.durum === 'Onaylandi') {
                        row.classList.add('table-success');
                    } else if (data.durum === 'Iptal') {
                        row.classList.add('table-secondary');
                    }
                }
            });

            tablo.on('xhr.dt', function (e, settings, json) {
                document.getElementById('kayitSayaci').textContent = json.recordsFiltered + ' kayıt';
            });

            sutunFiltreleriBagla('satisTeklifiTablosu', tablo);
        });
    </script>
}
