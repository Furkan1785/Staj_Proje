@using SakaryaERP.Models
@model MusteriTalebiDetayViewModel
@{
    ViewData["Title"] = "Müşteri Talebi Detayı";

    var durumSinifi = Model.Durum switch
    {
        TalepDurum.Yeni => "bg-warning text-dark",
        TalepDurum.Isleniyor => "bg-info text-dark",
        TalepDurum.Tamamlandi => "bg-success",
        TalepDurum.Iptal => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Müşteri Talebi <small class="text-muted">(@Model.TalepNo)</small></h3>
    <div class="d-flex gap-2">
        @if (Model.Durum is TalepDurum.Yeni or TalepDurum.Isleniyor)
        {
            <a asp-controller="SatisTeklifi" asp-action="Ekle" asp-route-talepId="@Model.Id" class="btn btn-outline-primary">Teklif Oluştur</a>
        }
        @if (Model.Durum == TalepDurum.Yeni)
        {
            <form method="post" asp-action="IslemeAl" asp-route-id="@Model.Id" onsubmit="return confirm('Bu talep işleme alınsın mı?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">İşleme Al</button>
            </form>
        }
        @if (Model.Durum is TalepDurum.Yeni or TalepDurum.Isleniyor)
        {
            <form method="post" asp-action="IptalEt" asp-route-id="@Model.Id" onsubmit="return confirm('Bu talep iptal edilsin mi?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">İptal Et</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        Talep Bilgileri
        <span class="badge @durumSinifi">@Model.DurumText</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Tarih</dt>
            <dd class="col-sm-4">@Model.Tarih.ToString("dd.MM.yyyy")</dd>
            <dt class="col-sm-2">Müşteri</dt>
            <dd class="col-sm-4"><partial name="_CariLinki" model="(Model.CariId, Model.CariUnvan)" /></dd>
            <dt class="col-sm-2">İçerik</dt>
            <dd class="col-sm-10">@(Model.Icerik ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">İlişkili Teklifler</div>
    @if (Model.Teklifler.Count == 0)
    {
        <div class="card-body text-muted">Bu talepten henüz bir teklif oluşturulmadı.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Teklif No</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Teklifler)
                    {
                        <tr>
                            <td>@t.TeklifNo</td>
                            <td>@t.Tarih.ToString("dd.MM.yyyy")</td>
                            <td>@t.DurumText</td>
                            <td><a asp-controller="SatisTeklifi" asp-action="Detay" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Detay</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
