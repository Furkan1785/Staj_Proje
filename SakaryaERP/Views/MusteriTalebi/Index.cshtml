@{
    ViewData["Title"] = "Müşteri Talepleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Müşteri Talepleri</h3>
    <div class="d-flex align-items-center gap-3">
        <span id="kayitSayaci" class="badge bg-secondary">0 kayıt</span>
        <a asp-action="Ekle" class="btn btn-primary">+ Yeni Talep</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<div class="table-responsive">
    <table id="musteriTalebiTablosu" class="table table-striped table-bordered align-middle w-100 grid-sticky-header">
        <thead>
            <tr>
                <th>Talep No</th>
                <th>Tarih</th>
                <th>Müşteri</th>
                <th>İçerik</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th></th>
                <th>
                    <select class="form-select form-select-sm sutun-filtre">
                        <option value="">Tümü</option>
                        <option value="Yeni">Yeni</option>
                        <option value="Isleniyor">İşleniyor</option>
                        <option value="Tamamlandi">Tamamlandı</option>
                        <option value="Iptal">İptal</option>
                    </select>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<form id="csrfTokenHolder" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            var csrfToken = document.querySelector('#csrfTokenHolder input[name="__RequestVerificationToken"]').value;

            function aksiyonFormuOlustur(action, id, dugmeSinifi, dugmeMetni, onay) {
                return '<form method="post" action="/MusteriTalebi/' + action + '" class="d-inline" onsubmit="return confirm(\'' + onay + '\')">' +
                    '<input type="hidden" name="__RequestVerificationToken" value="' + csrfToken + '" />' +
                    '<input type="hidden" name="id" value="' + id + '" />' +
                    '<button type="submit" class="btn btn-sm ' + dugmeSinifi + '">' + dugmeMetni + '</button></form>';
            }

            var tablo = new DataTable('#musteriTalebiTablosu', {
                processing: true,
                serverSide: true,
                ajax: { url: '@Url.Action("ListeVerisi", "MusteriTalebi")', type: 'POST' },
                order: [[1, 'desc']],
                language: { url: '@Url.Content("~/lib/datatables/i18n/tr.json")' },
                columns: [
                    { data: 'talepNo' },
                    {
                        data: 'tarih',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('tr-TR');
                        }
                    },
                    { data: 'cariUnvan' },
                    { data: 'icerik', orderable: false, searchable: false },
                    { data: 'durumText' },
                    {
                        data: 'id',
                        orderable: false,
                        searchable: false,
                        render: function (id, type, row) {
                            var html = '<div class="d-flex flex-wrap gap-1">';
                            html += '<a href="/MusteriTalebi/Detay/' + id + '" class="btn btn-sm btn-outline-secondary">Detay</a>';
                            if (row.durum === 'Yeni' || row.durum === 'Isleniyor') {
                                html += '<a href="/SatisTeklifi/Ekle?talepId=' + id + '" class="btn btn-sm btn-outline-primary">Teklif Oluştur</a>';
                            }
                            if (row.durum === 'Yeni') {
                                html += aksiyonFormuOlustur('IslemeAl', id, 'btn-outline-secondary', 'İşleme Al', 'Bu talep işleme alınsın mı?');
                            }
                            if (row.durum === 'Yeni' || row.durum === 'Isleniyor') {
                                html += aksiyonFormuOlustur('IptalEt', id, 'btn-outline-danger', 'İptal Et', 'Bu talep iptal edilsin mi?');
                            }
                            html += '</div>';
                            return html;
                        }
                    }
                ],
                createdRow: function (row, data) {
                    if (data.durum === 'Yeni') {
                        row.classList.add('table-warning');
                    } else if (data.durum === 'Isleniyor') {
                        row.classList.add('table-info');
                    } else if (data.durum === 'Tamamlandi') {
                        row.classList.add('table-success');
                    } else if (data.durum === 'Iptal') {
                        row.classList.add('table-secondary');
                    }
                }
            });

            tablo.on('xhr.dt', function (e, settings, json) {
                document.getElementById('kayitSayaci').textContent = json.recordsFiltered + ' kayıt';
            });

            sutunFiltreleriBagla('musteriTalebiTablosu', tablo);
        });
    </script>
}
