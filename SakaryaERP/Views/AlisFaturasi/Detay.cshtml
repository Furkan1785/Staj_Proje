@using SakaryaERP.Models
@model AlisFaturasiDetayViewModel
@{
    ViewData["Title"] = "Alış Faturası Detayı";

    var durumSinifi = Model.Durum switch
    {
        BelgeDurum.Beklemede => "bg-warning text-dark",
        BelgeDurum.Onaylandi => "bg-success",
        BelgeDurum.Iptal => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Alış Faturası <small class="text-muted">(@Model.FaturaNo)</small></h3>
    <div class="d-flex gap-2">
        @if (Model.Durum == BelgeDurum.Beklemede)
        {
            <form method="post" asp-action="Onayla" asp-route-id="@Model.Id" onsubmit="return confirm('Bu fatura onaylansın mı? Cariye alacak hareketi eklenecek.')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success">Onayla</button>
            </form>
            <form method="post" asp-action="IptalEt" asp-route-id="@Model.Id" onsubmit="return confirm('Bu fatura iptal edilsin mi?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">İptal Et</button>
            </form>
        }
        @if (Model.Durum == BelgeDurum.Onaylandi)
        {
            <form method="post" asp-action="IptalEt" asp-route-id="@Model.Id" onsubmit="return confirm('Bu onaylı fatura iptal edilsin mi? Stok, cari bakiyesi ve muhasebe fişi ters yönde geri alınacak. Bu işlem geri alınamaz.')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">İptal Et</button>
            </form>
        }
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">PDF</a>
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<partial name="_BelgeZinciri" model="Model.Zincir" />

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        Fatura Bilgileri
        <span class="badge @durumSinifi">@Model.DurumText</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Tarih</dt>
            <dd class="col-sm-4">@Model.Tarih.ToString("dd.MM.yyyy")</dd>
            <dt class="col-sm-2">Tedarikçi</dt>
            <dd class="col-sm-4"><partial name="_CariLinki" model="(Model.CariId, Model.CariUnvan)" /></dd>
            <dt class="col-sm-2">Sipariş No</dt>
            <dd class="col-sm-4">@(Model.SiparisNo ?? "-")</dd>
            <dt class="col-sm-2">İrsaliye No</dt>
            <dd class="col-sm-4">@(Model.IrsaliyeNo ?? "-")</dd>
            <dt class="col-sm-2">Tedarikçi Fatura No</dt>
            <dd class="col-sm-4">@(Model.TedarikciFaturaNo ?? "-")</dd>
            <dt class="col-sm-2">Açıklama</dt>
            <dd class="col-sm-10">@(Model.Aciklama ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">Kalemler</div>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Malzeme Kodu</th>
                    <th>Malzeme Adı</th>
                    <th>Birim</th>
                    <th class="text-end">Miktar</th>
                    <th class="text-end">Birim Fiyat</th>
                    <th class="text-end">İskonto %</th>
                    <th class="text-end">KDV %</th>
                    <th class="text-end">Satır Toplamı</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model.Kalemler)
                {
                    <tr>
                        <td>@k.MalzemeKodu</td>
                        <td>@k.MalzemeAdi</td>
                        <td>@k.Birim</td>
                        <td class="text-end">@k.Miktar.ToString("N2")</td>
                        <td class="text-end">@k.BirimFiyat.ToString("N2")</td>
                        <td class="text-end">@k.Iskonto.ToString("N2")</td>
                        <td class="text-end">@k.KdvOrani.ToString("N2")</td>
                        <td class="text-end">@k.SatirToplami.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="7" class="text-end">Genel Toplam</th>
                    <th class="text-end">@Model.ToplamTutar.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
