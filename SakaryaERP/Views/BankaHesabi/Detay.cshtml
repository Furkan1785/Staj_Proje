@model BankaHesabiListItemViewModel
@{
    ViewData["Title"] = "Banka Hesabı Detayı";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">@Model.HesapAdi <small class="text-muted">(@Model.BankaAdi)</small></h3>
    <div class="d-flex gap-2">
        <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="card position-sticky" style="top: 1rem;">
            <div class="card-body text-center">
                <div class="text-muted small">Hesap Adı</div>
                <div class="fs-5 fw-semibold mb-2">@Model.HesapAdi</div>
                <div class="text-muted small">Banka Adı</div>
                <div class="fw-semibold mb-3">@Model.BankaAdi</div>
                <span class="badge @(Model.IsDeleted ? "bg-secondary" : "bg-success")">@(Model.IsDeleted ? "Pasif" : "Aktif")</span>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Bakiye</span>
                    <span class="fw-semibold">@Model.Bakiye.ToString("N2") @Model.ParaBirimi</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-header">Hesap Bilgileri</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">IBAN</dt>
                    <dd class="col-sm-9">@(Model.IBAN ?? "-")</dd>
                    <dt class="col-sm-3">Para Birimi</dt>
                    <dd class="col-sm-9">@Model.ParaBirimi</dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">İşlemler</div>
            <div class="card-body d-flex gap-2">
                @if (Model.IsDeleted)
                {
                    <form method="post" asp-action="AktifEt" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success">Aktif Et</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-action="PasifYap" asp-route-id="@Model.Id" onsubmit="return confirm('Bu hesap pasif yapılsın mı?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary">Pasif Yap</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
