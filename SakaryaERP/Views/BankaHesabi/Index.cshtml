@model IEnumerable<BankaHesabiListItemViewModel>
@{
    ViewData["Title"] = "Banka Hesapları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Banka Hesapları</h3>
    <div class="d-flex align-items-center gap-3">
        <span id="kayitSayaci" class="badge bg-secondary">0 kayıt</span>
        <a asp-action="Ekle" class="btn btn-primary">+ Yeni Banka Hesabı</a>
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

<div class="table-responsive">
    <table id="bankaHesabiTablosu" class="table table-striped table-bordered align-middle w-100 grid-sticky-header">
        <thead>
            <tr>
                <th>Hesap Adı</th>
                <th>Banka Adı</th>
                <th>IBAN</th>
                <th>Bakiye</th>
                <th>Para Birimi</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th></th>
                <th><input type="text" class="form-control form-control-sm sutun-filtre" placeholder="Ara" /></th>
                <th>
                    <select class="form-select form-select-sm sutun-filtre">
                        <option value="">Tümü</option>
                        <option value="Aktif">Aktif</option>
                        <option value="Pasif">Pasif</option>
                    </select>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td>@h.HesapAdi</td>
                    <td>@h.BankaAdi</td>
                    <td>@h.IBAN</td>
                    <td>@h.Bakiye.ToString("N2")</td>
                    <td>@h.ParaBirimi</td>
                    <td>
                        @if (h.IsDeleted)
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Duzenle" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary me-1">Düzenle</a>
                        @if (h.IsDeleted)
                        {
                            <form asp-action="AktifEt" asp-route-id="@h.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Aktif Et</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="PasifYap" asp-route-id="@h.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Pasif Yap</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            var tablo = new DataTable('#bankaHesabiTablosu', {
                order: [[0, 'asc']],
                language: { url: '@Url.Content("~/lib/datatables/i18n/tr.json")' },
                columnDefs: [{ targets: -1, orderable: false, searchable: false }]
            });

            tablo.on('draw', function () {
                document.getElementById('kayitSayaci').textContent = tablo.rows({ search: 'applied' }).count() + ' kayıt';
            });
            tablo.draw();

            sutunFiltreleriBagla('bankaHesabiTablosu', tablo);
        });
    </script>
}
