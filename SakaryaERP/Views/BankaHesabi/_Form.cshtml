@model BankaHesabiFormViewModel

<input type="hidden" asp-for="Id" />

<div class="card">
    <div class="card-header">Hesap Bilgileri</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="HesapAdi" class="form-label"></label>
                <input asp-for="HesapAdi" class="form-control" />
                <span asp-validation-for="HesapAdi" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BankaAdi" class="form-label"></label>
                <input asp-for="BankaAdi" class="form-control" />
                <span asp-validation-for="BankaAdi" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ParaBirimi" class="form-label"></label>
                <select asp-for="ParaBirimi" class="form-select">
                    <option value="TRY">TRY</option>
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                </select>
                <span asp-validation-for="ParaBirimi" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="IBAN" class="form-label"></label>
                <input asp-for="IBAN" class="form-control" />
                <span asp-validation-for="IBAN" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</div>
