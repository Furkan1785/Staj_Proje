@model CariFisiFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="CariId" class="form-label"></label>
        <select asp-for="CariId" class="form-select" asp-items="Model.CariListesi">
            <option value="">Seçiniz</option>
        </select>
        <span asp-validation-for="CariId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Tarih" class="form-label"></label>
        <input asp-for="Tarih" class="form-control" />
        <span asp-validation-for="Tarih" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Tutar" class="form-label"></label>
        <input asp-for="Tutar" class="form-control" />
        <span asp-validation-for="Tutar" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="FisTipi" class="form-label"></label>
        <select asp-for="FisTipi" id="fisTipiSecimi" class="form-select" asp-items="Html.GetEnumSelectList<FisTipi>()"></select>
        <span asp-validation-for="FisTipi" class="text-danger"></span>
    </div>
    <div class="col-md-4" id="odemeYontemiAlani">
        <label asp-for="OdemeYontemi" class="form-label"></label>
        <select asp-for="OdemeYontemi" id="odemeYontemiSecimi" class="form-select" asp-items="Html.GetEnumSelectList<OdemeYontemi>()"></select>
        <span asp-validation-for="OdemeYontemi" class="text-danger"></span>
    </div>
    <div class="col-md-4" id="kasaHesabiAlani">
        <label asp-for="KasaHesabiId" class="form-label"></label>
        <select asp-for="KasaHesabiId" class="form-select" asp-items="Model.KasaHesabiListesi">
            <option value="">Seçiniz</option>
        </select>
        <span asp-validation-for="KasaHesabiId" class="text-danger"></span>
    </div>
    <div class="col-md-4" id="bankaHesabiAlani">
        <label asp-for="BankaHesabiId" class="form-label"></label>
        <select asp-for="BankaHesabiId" class="form-select" asp-items="Model.BankaHesabiListesi">
            <option value="">Seçiniz</option>
        </select>
        <span asp-validation-for="BankaHesabiId" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Aciklama" class="form-label"></label>
        <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Aciklama" class="text-danger"></span>
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</div>

<script>
    (function () {
        var fisTipiSecimi = document.getElementById('fisTipiSecimi');
        var odemeYontemiAlani = document.getElementById('odemeYontemiAlani');
        var odemeYontemiSecimi = document.getElementById('odemeYontemiSecimi');
        var kasaHesabiAlani = document.getElementById('kasaHesabiAlani');
        var bankaHesabiAlani = document.getElementById('bankaHesabiAlani');

        function alanlariGuncelle() {
            var mahsup = fisTipiSecimi.value === 'Mahsup';
            odemeYontemiAlani.classList.toggle('d-none', mahsup);

            var nakit = !mahsup && odemeYontemiSecimi.value === 'Nakit';
            var bankaGerekli = !mahsup && !nakit;

            kasaHesabiAlani.classList.toggle('d-none', mahsup || !nakit);
            bankaHesabiAlani.classList.toggle('d-none', mahsup || !bankaGerekli);
        }

        fisTipiSecimi.addEventListener('change', alanlariGuncelle);
        odemeYontemiSecimi.addEventListener('change', alanlariGuncelle);
        alanlariGuncelle();
    })();
</script>
