@model SatisOzetViewModel
@{
    ViewData["Title"] = "Satış Özet Raporu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Satış Özet Raporu</h3>
    <span class="badge bg-primary fs-6">Genel Toplam: @Model.GenelToplam.ToString("N2")</span>
</div>

@if (Model.MusteriToplamlari.Count == 0)
{
    <div class="alert alert-info">Henüz onaylanmış bir satış faturası bulunmuyor.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Müşteri Bazlı Satış Toplamları</div>
                <div class="card-body">
                    <canvas id="musteriGrafik" height="260"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Malzeme Bazlı Satış Toplamları</div>
                <div class="card-body">
                    <canvas id="malzemeGrafik" height="260"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card">
                <div class="card-header">Aylık Satış Trendi</div>
                <div class="card-body">
                    <canvas id="aylikGrafik" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Müşteri Bazlı Satış Toplamları (Tablo)</div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Müşteri</th>
                                <th class="text-end">Toplam Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.MusteriToplamlari)
                            {
                                <tr>
                                    <td>@t.CariUnvan</td>
                                    <td class="text-end">@t.ToplamTutar.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Malzeme Bazlı Satış Toplamları (Tablo)</div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Malzeme</th>
                                <th class="text-end">Toplam Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.MalzemeToplamlari)
                            {
                                <tr>
                                    <td>@t.MalzemeAdi</td>
                                    <td class="text-end">@t.ToplamTutar.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        var musteriEtiketler = @Json.Serialize(Model.MusteriToplamlari.Select(t => t.CariUnvan));
        var musteriTutarlar = @Json.Serialize(Model.MusteriToplamlari.Select(t => t.ToplamTutar));
        var malzemeEtiketler = @Json.Serialize(Model.MalzemeToplamlari.Select(t => t.MalzemeAdi));
        var malzemeTutarlar = @Json.Serialize(Model.MalzemeToplamlari.Select(t => t.ToplamTutar));
        var aylikEtiketler = @Json.Serialize(Model.AylikToplamlar.Select(a => a.Etiket));
        var aylikTutarlar = @Json.Serialize(Model.AylikToplamlar.Select(a => a.ToplamTutar));

        var mavi = '#2a78d6';
        var izgaraRengi = '#e1e0d9';
        var eksenRengi = '#898781';

        function barGrafikOlustur(elemanId, etiketler, tutarlar) {
            if (etiketler.length === 0) return;
            new Chart(document.getElementById(elemanId), {
                type: 'bar',
                data: {
                    labels: etiketler,
                    datasets: [{ label: 'Toplam Tutar', data: tutarlar, backgroundColor: mavi, borderRadius: 4 }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { ticks: { color: eksenRengi }, grid: { display: false } },
                        y: { ticks: { color: eksenRengi }, grid: { color: izgaraRengi } }
                    }
                }
            });
        }

        barGrafikOlustur('musteriGrafik', musteriEtiketler, musteriTutarlar);
        barGrafikOlustur('malzemeGrafik', malzemeEtiketler, malzemeTutarlar);

        if (aylikEtiketler.length > 0) {
            new Chart(document.getElementById('aylikGrafik'), {
                type: 'line',
                data: {
                    labels: aylikEtiketler,
                    datasets: [{
                        label: 'Toplam Tutar',
                        data: aylikTutarlar,
                        borderColor: mavi,
                        backgroundColor: mavi,
                        tension: 0.25,
                        pointRadius: 4,
                        borderWidth: 2
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { ticks: { color: eksenRengi }, grid: { display: false } },
                        y: { ticks: { color: eksenRengi }, grid: { color: izgaraRengi } }
                    }
                }
            });
        }
    </script>
}
