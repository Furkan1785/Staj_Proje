@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var satisGorunumu = Model.SeciliTur == DashboardGorunumTuru.Satis;

    var kategoriBazliVeri = satisGorunumu ? Model.KategoriBazliSatis : Model.KategoriBazliAlis;
    var aylikTrendVeri = satisGorunumu ? Model.AylikSatisTrendi : Model.AylikAlisTrendi;
    var topBirinciVeri = satisGorunumu ? Model.EnCokSatisYapilanMusteriler : Model.EnCokAlisYapilanTedarikciler;
    var topIkinciVeri = satisGorunumu ? Model.EnCokSatilanMalzemeler : Model.EnCokAlinanMalzemeler;

    var kategoriBaslik = satisGorunumu ? "Kategori Bazlı Satış" : "Kategori Bazlı Alış";
    var trendBaslik = satisGorunumu ? "Aylık Satış Trendi" : "Aylık Alış Trendi";
    var topBirinciBaslik = satisGorunumu ? "En Çok Satış Yapılan Müşteriler" : "En Çok Alış Yapılan Tedarikçiler";
    var topIkinciBaslik = satisGorunumu ? "En Çok Satılan Malzemeler" : "En Çok Alınan Malzemeler";
}

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

@if (User.IsInRole("Admin"))
{
    <form method="post" asp-controller="Bildirim" asp-action="SimdiGonder" class="d-inline float-end mb-2"
          onsubmit="return confirm('Kritik stok ve vadesi yaklaşan çek/senet için Admin kullanıcılara özet e-posta gönderilsin mi?')">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-outline-secondary">Bildirimleri Şimdi Gönder</button>
    </form>
}

<form method="get" id="dashboardFiltreForm">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h3 class="mb-0">Dashboard</h3>
        <div class="d-flex align-items-center gap-2">
            <label for="turSecimi" class="form-label small text-muted mb-0">Dashboard</label>
            <select name="tur" id="turSecimi" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="Satis" selected="@(satisGorunumu)">Satış Dashboard</option>
                <option value="Satinalma" selected="@(!satisGorunumu)">Satınalma Dashboard</option>
            </select>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-9 order-2 order-lg-1">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card h-100 stat-tile-group">
                        <div class="card-header">Toplam Satış</div>
                        <div class="card-body" style="--stat-tile-accent: #2a78d6;">
                            <div class="stat-tile-row">
                                <div class="stat-tile">
                                    <div class="stat-tile-label">TRY</div>
                                    <div class="stat-tile-value">₺ @Model.GenelSatisToplamiTRY.ToString("N0")</div>
                                </div>
                                <div class="stat-tile">
                                    <div class="stat-tile-label">USD</div>
                                    <div class="stat-tile-value">$ @Model.GenelSatisToplamiUSD.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 stat-tile-group">
                        <div class="card-header">Toplam Satınalma</div>
                        <div class="card-body" style="--stat-tile-accent: #4a3aa7;">
                            <div class="stat-tile-row">
                                <div class="stat-tile">
                                    <div class="stat-tile-label">TRY</div>
                                    <div class="stat-tile-value">₺ @Model.GenelSatinalmaToplamiTRY.ToString("N0")</div>
                                </div>
                                <div class="stat-tile">
                                    <div class="stat-tile-label">USD</div>
                                    <div class="stat-tile-value">$ @Model.GenelSatinalmaToplamiUSD.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-lg-5">
                    <div class="card h-100">
                        <div class="card-header">@kategoriBaslik</div>
                        <div class="card-body">
                            @if (kategoriBazliVeri.Count == 0)
                            {
                                <div class="alert alert-info mb-0">Seçili filtrelerle eşleşen onaylanmış bir belge bulunmuyor.</div>
                            }
                            else
                            {
                                <canvas id="kategoriGrafik" height="260"></canvas>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="card h-100">
                        <div class="card-header">@trendBaslik (@Model.OncekiYil - @Model.BuYil)</div>
                        <div class="card-body">
                            @if (aylikTrendVeri.All(a => a.OncekiYilToplam == 0 && a.BuYilToplam == 0))
                            {
                                <div class="alert alert-info mb-0">Seçili filtrelerle eşleşen onaylanmış bir belge bulunmuyor.</div>
                            }
                            else
                            {
                                <canvas id="aylikTrendGrafik" height="180"></canvas>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header">@topBirinciBaslik</div>
                        <div class="card-body">
                            @if (topBirinciVeri.Count == 0)
                            {
                                <div class="alert alert-info mb-0">Seçili filtrelerle eşleşen onaylanmış bir belge bulunmuyor.</div>
                            }
                            else
                            {
                                <canvas id="musteriGrafik" height="220"></canvas>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header">@topIkinciBaslik</div>
                        <div class="card-body">
                            @if (topIkinciVeri.Count == 0)
                            {
                                <div class="alert alert-info mb-0">Seçili filtrelerle eşleşen onaylanmış bir belge bulunmuyor.</div>
                            }
                            else
                            {
                                <canvas id="malzemeGrafik" height="220"></canvas>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1 mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>Kritik Stok Uyarı Listesi</span>
                            <a asp-controller="StokRaporu" asp-action="KritikStok" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
                        </div>
                        <div class="table-responsive">
                            @if (Model.KritikStokListesi.Count == 0)
                            {
                                <div class="alert alert-success mb-0">Kritik stokta malzeme bulunmuyor.</div>
                            }
                            else
                            {
                                <table class="table table-striped align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Malzeme Kodu</th>
                                            <th>Malzeme Adı</th>
                                            <th>Kategori</th>
                                            <th class="text-end">Bakiye</th>
                                            <th class="text-end">Min. Stok</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in Model.KritikStokListesi)
                                        {
                                            <tr>
                                                <td>@m.MalzemeKodu</td>
                                                <td>@m.MalzemeAdi</td>
                                                <td>@(m.KategoriAdi ?? "-")</td>
                                                <td class="text-end">@m.Bakiye.ToString("N2") @m.Birim</td>
                                                <td class="text-end">@m.MinStokMiktari.ToString("N2")</td>
                                                <td><span class="badge @m.DurumSinifi">@m.DurumText</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 order-1 order-lg-2">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-header">Tarih Aralığı Seç</div>
                <div class="card-body">
                    <select name="aralik" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="TumZamanlar" selected="@(Model.SeciliAralik == DashboardAralik.TumZamanlar)">Tüm Zamanlar</option>
                        <option value="BuAy" selected="@(Model.SeciliAralik == DashboardAralik.BuAy)">Bu Ay</option>
                        <option value="BuYil" selected="@(Model.SeciliAralik == DashboardAralik.BuYil)">Bu Yıl</option>
                    </select>
                    <p class="text-muted small mt-2 mb-0">Aylık trend grafiği her zaman @Model.OncekiYil-@Model.BuYil karşılaştırmasını gösterir, bu filtreden etkilenmez.</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">Malzeme Kategorileri</div>
                <div class="card-body" style="max-height: 340px; overflow-y: auto;">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="kategoriHepsi" checked="@(Model.SeciliKategoriIdler.Count == 0)">
                        <label class="form-check-label fw-semibold" for="kategoriHepsi">Hepsi</label>
                    </div>
                    <hr class="my-2" />
                    @foreach (var k in Model.KategoriFiltreListesi)
                    {
                        <div class="form-check" style="margin-left: @(k.Seviye * 1)rem;">
                            <input class="form-check-input kategori-checkbox" type="checkbox" name="kategoriId" value="@k.Id" id="kategori-@k.Id"
                                   checked="@(Model.SeciliKategoriIdler.Contains(k.Id))" />
                            <label class="form-check-label" for="kategori-@k.Id">@k.KategoriAdi</label>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-sm btn-primary w-100">Uygula</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        document.getElementById('kategoriHepsi').addEventListener('change', function () {
            if (this.checked) {
                document.querySelectorAll('.kategori-checkbox').forEach(function (cb) { cb.checked = false; });
            }
        });
        document.querySelectorAll('.kategori-checkbox').forEach(function (cb) {
            cb.addEventListener('change', function () {
                if (this.checked) document.getElementById('kategoriHepsi').checked = false;
            });
        });

        var kategoriEtiketler = @Json.Serialize(kategoriBazliVeri.Select(k => k.KategoriAdi));
        var kategoriTutarlar = @Json.Serialize(kategoriBazliVeri.Select(k => k.ToplamTutar));

        var aylikEtiketler = @Json.Serialize(aylikTrendVeri.Select(a => a.AyAdi));
        var aylikOncekiYil = @Json.Serialize(aylikTrendVeri.Select(a => a.OncekiYilToplam));
        var aylikBuYil = @Json.Serialize(aylikTrendVeri.Select(a => a.BuYilToplam));

        var topBirinciEtiketler = @Json.Serialize(topBirinciVeri.Select(t => t.CariUnvan));
        var topBirinciTutarlar = @Json.Serialize(topBirinciVeri.Select(t => t.ToplamTutar));
        var topIkinciEtiketler = @Json.Serialize(topIkinciVeri.Select(t => t.MalzemeAdi));
        var topIkinciTutarlar = @Json.Serialize(topIkinciVeri.Select(t => t.ToplamTutar));

        var mavi = '#2a78d6';
        var turuncu = '#eb6834';
        var kategorik = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7', '#e34948'];
        var izgaraRengi = '#e1e0d9';
        var eksenRengi = '#898781';
        var metinRengi = '#52514e';
        var yuzeyRengi = '#fff';

        function paraFormatla(deger) {
            return Number(deger).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Kategorik renklerin üstüne yazılan etiket, zemin rengine göre siyah/beyaz seçilir
        // (dataviz kuralı: metin veri rengini giymez, dolgu üstündeki etiket zeminin
        // parlaklığına göre okunur renk alır).
        function metinRenginiSec(hexRenk) {
            var r = parseInt(hexRenk.slice(1, 3), 16);
            var g = parseInt(hexRenk.slice(3, 5), 16);
            var b = parseInt(hexRenk.slice(5, 7), 16);
            var parlaklik = (r * 299 + g * 587 + b * 114) / 1000;
            return parlaklik > 150 ? '#0b0b0b' : '#ffffff';
        }

        function barGrafikOlustur(elemanId, etiketler, tutarlar) {
            if (etiketler.length === 0) return;
            new Chart(document.getElementById(elemanId), {
                type: 'bar',
                data: {
                    labels: etiketler,
                    datasets: [{ label: 'Toplam Tutar', data: tutarlar, backgroundColor: mavi, borderRadius: 4, maxBarThickness: 24 }]
                },
                options: {
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: function (ctx) { return paraFormatla(ctx.parsed.y ?? ctx.parsed.x) + ' ₺'; } } }
                    },
                    scales: {
                        x: { ticks: { color: eksenRengi }, grid: { display: false } },
                        y: { ticks: { color: eksenRengi }, grid: { color: izgaraRengi } }
                    }
                }
            });
        }

        barGrafikOlustur('musteriGrafik', topBirinciEtiketler, topBirinciTutarlar);
        barGrafikOlustur('malzemeGrafik', topIkinciEtiketler, topIkinciTutarlar);

        if (kategoriEtiketler.length > 0) {
            var kategoriToplam = kategoriTutarlar.reduce(function (a, b) { return a + b; }, 0);
            var dilimEtiketleriEklentisi = {
                id: 'dilimEtiketleri',
                afterDatasetsDraw: function (chart) {
                    var ctx = chart.ctx;
                    var meta = chart.getDatasetMeta(0);
                    ctx.save();
                    ctx.font = '600 12px system-ui, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    meta.data.forEach(function (dilim, i) {
                        var pay = kategoriTutarlar[i] / kategoriToplam;
                        if (pay < 0.03) return; // çok küçük dilimde etiket sığmaz, legend yeterli
                        var pozisyon = dilim.tooltipPosition();
                        ctx.fillStyle = metinRenginiSec(kategorik[i % kategorik.length]);
                        ctx.fillText('%' + Math.round(pay * 100), pozisyon.x, pozisyon.y);
                    });
                    ctx.restore();
                }
            };

            var toplamMerkezEklentisi = {
                id: 'toplamMerkezi',
                afterDraw: function (chart) {
                    var ctx = chart.ctx;
                    var x = (chart.chartArea.left + chart.chartArea.right) / 2;
                    var y = (chart.chartArea.top + chart.chartArea.bottom) / 2;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.font = '600 11px system-ui, sans-serif';
                    ctx.fillStyle = eksenRengi;
                    ctx.fillText('Toplam', x, y - 10);
                    ctx.font = '700 15px system-ui, sans-serif';
                    ctx.fillStyle = metinRengi;
                    ctx.fillText('₺' + Math.round(kategoriToplam).toLocaleString('tr-TR'), x, y + 10);
                    ctx.restore();
                }
            };

            new Chart(document.getElementById('kategoriGrafik'), {
                type: 'doughnut',
                data: {
                    labels: kategoriEtiketler,
                    datasets: [{ data: kategoriTutarlar, backgroundColor: kategorik.slice(0, kategoriEtiketler.length), borderColor: yuzeyRengi, borderWidth: 2 }]
                },
                options: {
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'right', labels: { color: metinRengi, boxWidth: 14, padding: 12 } },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    var pay = ctx.parsed / kategoriToplam;
                                    return ctx.label + ': ' + paraFormatla(ctx.parsed) + ' ₺ (%' + (pay * 100).toFixed(1) + ')';
                                }
                            }
                        }
                    }
                },
                plugins: [dilimEtiketleriEklentisi, toplamMerkezEklentisi]
            });
        }

        if (aylikEtiketler.length > 0) {
            new Chart(document.getElementById('aylikTrendGrafik'), {
                type: 'line',
                data: {
                    labels: aylikEtiketler,
                    datasets: [
                        { label: '@Model.OncekiYil', data: aylikOncekiYil, borderColor: mavi, backgroundColor: mavi, tension: 0.25, pointRadius: 4, pointBorderWidth: 2, pointBorderColor: yuzeyRengi, borderWidth: 2 },
                        { label: '@Model.BuYil', data: aylikBuYil, borderColor: turuncu, backgroundColor: turuncu, tension: 0.25, pointRadius: 4, pointBorderWidth: 2, pointBorderColor: yuzeyRengi, borderWidth: 2 }
                    ]
                },
                options: {
                    plugins: {
                        legend: { display: true, labels: { color: metinRengi } },
                        tooltip: { callbacks: { label: function (ctx) { return ctx.dataset.label + ': ' + paraFormatla(ctx.parsed.y) + ' ₺'; } } }
                    },
                    scales: {
                        x: { ticks: { color: eksenRengi }, grid: { display: false } },
                        y: { ticks: { color: eksenRengi }, grid: { color: izgaraRengi } }
                    }
                }
            });
        }
    </script>
}
